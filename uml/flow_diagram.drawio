        <!-- ===== Ghi chú chiến lược backpressure ===== -->
        <mxCell id="note" value="&#xa;Backpressure strategies:&#xa;&#xa;• Block       — producer chờ consumer&#xa;• Drop        — bỏ event mới&#xa;• DropOldest  — bỏ event cũ nhất&#xa;• Buffer      — xếp hàng (queue unbounded)&#xa;" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;fillColor=#fff2cc;strokeColor=#d6b656;size=14;align=left;verticalAlign=top;fontSize=11;" vertex="1" parent="1">
